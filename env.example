# Database
# Use sua URL do Prisma ou PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/isekai?schema=public"

# PostgreSQL URL (opcional, backup)
# POSTGRES_URL="postgres://user:password@host:5432/database?sslmode=require"

# Prisma Accelerate (opcional, para melhor performance)
# PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# NextAuth.js Configuration (não mais necessário, mas mantido para compatibilidade)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-a-random-string